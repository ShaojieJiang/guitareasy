# Copy to .env for `npm run dev`; wrangler dev loads it as local variables.
# Non-production mode offers local Google/Apple test sign-ins when their
# credentials are unset, and logs email sign-in codes (also shown in the
# sign-in dialog) unless SMTP_HOST and SMTP_FROM are set.
ENVIRONMENT=development
# The Vite dev server proxies /api to this worker; cookies and OAuth
# redirects must use the browser-visible origin.
PUBLIC_ORIGIN=http://localhost:65432
AUTH_SECRET=change-me-local-secret
# Wrangler expands $NAME references in .env values, even inside quotes:
# write a literal dollar sign as \$ (e.g. SMTP_PASSWORD="abc\$123").
#
# Sign-in emails over SMTP (the same settings as GatherEasy). Port 465 uses
# implicit TLS; other ports use STARTTLS unless SMTP_STARTTLS=0.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@guitareasy.app
# SMTP_FROM_NAME=GuitarEasy
# SMTP_STARTTLS=1
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
